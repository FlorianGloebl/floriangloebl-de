---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PostCard from '../components/PostCard.astro';
import Book from '../components/Book.astro';
import { site, mailto } from '../data/site';
import { book, recommendations } from '../data/book';
import { getPosts } from '../data/posts';

const latest = (await getPosts()).slice(0, 2);
const c = site.contact;
const roles = [
  {
    name: 'Glöbl & Partner',
    url: 'https://www.g-u-p.de/',
    role: 'Geschäftsführer',
    text: 'Beratung für produzierende Mittelständler, mit Fokus auf Wertschöpfung statt auf Methoden: Organisation, Führung & Nachfolge, Lean, Prozesse & Supply Chain sowie ERP, KI & Digitalisierung.',
  },
  {
    name: 'Coolab AG',
    url: 'https://coolab.ch/',
    role: 'Mitgründer & Verwaltungsrat',
    text: 'Gemeinsam mit Maria Büchner, Fabio Oro und Benno Löffler. Klarheit, Fokus und tragfähige Strukturen für Schweizer KMU – mit KI dort, wo sie echten Mehrwert bringt.',
  },
  {
    name: 'Werkskante',
    url: 'https://www.werkskante.de/',
    role: 'Inhaber · Möglichmacher',
    text: 'Arbeitssicherheit, die rechtlich stimmt und im Betrieb funktioniert. Daraus entsteht gerade eine Plattform, auf der sich andere selbstständig machen können – ich unterstütze sie dabei.',
  },
  {
    name: 'Vollmer & Scheffczyk',
    url: 'https://v-und-s.de/',
    role: 'Partner',
    text: '„Wertschöpfung neu beraten“: Lean, Agilität und Multiprojektmanagement für mehr Wettbewerbskraft im produzierenden Mittelstand.',
  },
];
const mentors = [
  { id: 'mentor-heitzer', name: 'Josef Heitzer' },
  { id: 'mentor-hauk', name: 'Arnold Hauk' },
  { id: 'mentor-prinz', name: 'Peter Prinz' },
  { id: 'mentor-loeffler', name: 'Benno Löffler' },
];
---

<Base>
  <!-- Einstieg -->
  <section class="hero" aria-labelledby="hallo">
    <div class="wrap">
      <div>
        <p class="kicker">Coaching · Mentoring · Gründen</p>
        <h1 id="hallo">Hallo, ich bin Flo.</h1>
        <p class="lead">
          Ich begleite Menschen im Coaching und unterstütze Führungskräfte bei ihren Fragen und Entscheidungen. Als
          Mentor teile ich meine Erfahrung, und wer gründen will, dem helfe ich beim Start. In meiner freien Zeit bin ich
          am liebsten in Bewegung: beim Bergsteigen, auf dem Rennrad, beim Skifahren oder auf dem Tennisplatz.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href="#coaching">Coaching kennenlernen</a>
          <a class="btn btn--ghost" href="#ueber-mich">Mehr über mich</a>
        </div>
      </div>
      <div class="hero__media">
        <Photo id="hero-berge" sizes="(max-width: 760px) 100vw, 46vw" priority />
        <a class="hero-book" href={book.url} rel="noopener" aria-label={`Zur Website des Buchs ${book.title}`}>
          <Book />
          <span class="hero-book__label">Neues Buch · {book.releaseShort}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Kurzbiografie -->
  <section class="section" id="ueber-mich" aria-labelledby="mein-weg">
    <div class="wrap">
      <p class="kicker">Über mich</p>
      <div class="split">
        <div class="prose">
          <h2 id="mein-weg">Mein Weg</h2>
          <p>
            Ich bin Florian Glöbl und lebe in Laberweinting. Fast 16 Jahre lang war ich bei einem Maschinenbauer in der
            Region. Angefangen habe ich in der Beschaffung, über Logistik und Produktionsplanung ging es in die
            Materialwirtschaft. Später habe ich Arbeitsvorbereitung, Materialwirtschaft und Versand geleitet, zuletzt war
            ich Mitglied der Geschäftsleitung. Dort habe ich erlebt, wie eng gute Zusammenarbeit und das tägliche
            Funktionieren eines Unternehmens zusammenhängen.
          </p>
          <p>Heute bin ich in mehreren Rollen unterwegs:</p>
          <ul class="roles">
            {roles.map((r) => (
              <li>
                <a href={r.url} rel="noopener">{r.name}</a>
                <em>{r.role}</em>
                <span>{r.text}</span>
              </li>
            ))}
          </ul>
          <p>
            Mich interessiert, was Menschen und Unternehmen in ihrer konkreten Situation weiterhilft. Und ganz ehrlich:
            Mir macht es auch Spaß, ab und zu selbst zu programmieren.
          </p>
        </div>
        <Photo id="portrait" sizes="(max-width: 760px) 100vw, 40vw" />
      </div>
    </div>
  </section>

  <!-- Angebote: vier Bereiche, Coaching zuerst -->
  <section class="section" id="coaching" aria-labelledby="angebote">
    <div class="wrap">
      <p class="kicker">Angebote</p>
      <div class="offers-intro" data-reveal>
        <h2 id="angebote">Wobei ich dich unterstützen kann</h2>
        <p class="subline">Umfang und Honorar vereinbaren wir passend zu deinem Anliegen.</p>
      </div>

      <div class="offer-cards">
        <article class="offer-card offer-card--main" data-reveal>
          <p class="offer-num" aria-hidden="true">01</p>
          <h3>Coaching</h3>
          <p class="subline">Für dich persönlich und für Führungskräfte</p>
          <p>
            Wenn eine Entscheidung ansteht, die eigene Rolle unklar wird oder Führung gerade mehr Fragen als Antworten
            bringt, kann ein Gespräch von außen helfen. Ich unterstütze dich dabei, deine Situation zu sortieren und
            nächste Schritte zu entwickeln, die für dich passen.
          </p>
          <div class="offer-detail">
            <strong>Typische Anlässe</strong>
            <ul class="arrows">
              <li>Neue Führungsrolle</li>
              <li>Schwierige Gespräche</li>
              <li>Berufliche Orientierung</li>
            </ul>
            Nach dem Kennenlernen sind einzelne Gespräche oder mehrere Termine möglich.
          </div>
          <div class="actions">
            <a class="btn btn--primary" href={mailto('Anfrage Coaching')}>Coaching anfragen</a>
          </div>
        </article>

        <article class="offer-card offer-card--main" data-reveal>
          <p class="offer-num" aria-hidden="true">02</p>
          <h3>Mentoring</h3>
          <p class="subline">Begleitung über einen längeren Zeitraum</p>
          <p>
            Manche Fragen lassen sich nicht in einem Termin beantworten. Im Mentoring begleite ich dich über einen
            längeren Zeitraum, teile eigene Erfahrungen und denke mit dir weiter. Du bringst deine konkreten Fragen mit;
            wir prüfen gemeinsam, was du als Nächstes ausprobieren möchtest.
          </p>
          <div class="offer-detail">
            <strong>Arbeitsweise</strong>
            Erfahrung und fachliche Rückmeldung sind ausdrücklich Teil der Begleitung. Rhythmus und Dauer vereinbaren wir
            individuell.
          </div>
          <div class="actions">
            <a class="btn btn--primary" href={mailto('Anfrage Mentoring')}>Mentoring anfragen</a>
          </div>
        </article>

        <article class="offer-card offer-card--main" id="weitere-angebote" data-reveal>
          <p class="offer-num" aria-hidden="true">03</p>
          <h3>Gründen</h3>
          <p class="subline">Eine Idee auf eigene Beine stellen</p>
          <p>
            Du möchtest ein Unternehmen gründen oder eine Idee auf eigene Beine stellen? Ich helfe dir, dein Angebot zu
            schärfen, mögliche Kunden besser zu verstehen und die ersten Schritte zu ordnen.
          </p>
          <div class="offer-detail">
            <strong>Ergebnis</strong>
            Ein klares Angebot und erste Kundengespräche. Steuerliche und rechtliche Fragen gehören zu den
            entsprechenden Fachleuten.
          </div>
          <div class="actions">
            <a class="btn btn--primary" href={mailto('Anfrage Gründung')}>Gründung besprechen</a>
          </div>
        </article>

        <article class="offer-card offer-card--main" data-reveal>
          <p class="offer-num" aria-hidden="true">04</p>
          <h3>Von der Idee zum Prototyp</h3>
          <p class="subline">Schnell zum ersten greifbaren Ergebnis</p>
          <p>
            Eine Idee oder ein Prozess soll nicht ewig auf dem Papier bleiben. Gemeinsam bringen wir sie zum ersten
            Ergebnis oder Prototyp, mit dem man arbeiten und lernen kann. Das kann ein neu gedachter Ablauf sein, eine
            einfache Website oder ein kleines digitales Werkzeug.
          </p>
          <div class="offer-detail">
            <strong>Vorgehen</strong>
            Klein anfangen, ausprobieren, anhand der Rückmeldungen verbessern. Wie es danach weitergeht, entscheiden wir
            gemeinsam.
          </div>
          <div class="actions">
            <a class="btn btn--primary" href={mailto('Anfrage Prototyp')}>Idee besprechen</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Draußen und im Verein -->
  <section class="section" id="draussen" aria-labelledby="draussen-titel">
    <div class="wrap">
      <p class="kicker">Draußen und mittendrin</p>
      <div class="columns">
        <div class="prose">
          <h2 id="draussen-titel">Bewegung tut mir einfach gut</h2>
          <p>
            Berge und Sport gehören zu meinem Leben. Ich gehe bergsteigen und bin gern auf Klettersteigen unterwegs, ich
            fahre Rennrad und Ski und spiele Tennis und Fußball. Dazu kommt mein Engagement in den örtlichen Vereinen.
            Beim Fotografieren halte ich gern fest, was mir unterwegs begegnet.
          </p>
        </div>
        <div class="prose">
          <p class="lead">
            Ich bin ein leidenschaftlicher Netzwerker. Ich lerne gern neue Menschen kennen, tausche Ideen aus und
            probiere Neues aus.
          </p>
          <p>
            Mich interessiert, was andere antreibt und was wir voneinander lernen können. Diese Neugier begleitet mich
            privat genauso wie bei meiner Arbeit.
          </p>
        </div>
      </div>

      <div class="strip" data-reveal>
        <Photo id="draussen-gipfelkreuz" sizes="(max-width: 760px) 50vw, 280px" widths={[360, 560, 720]} />
        <Photo id="draussen-grat" sizes="(max-width: 760px) 50vw, 280px" widths={[360, 560, 720]} />
        <Photo id="draussen-skitour" sizes="(max-width: 760px) 50vw, 280px" widths={[360, 560, 720]} />
        <Photo id="draussen-rennrad" sizes="(max-width: 760px) 50vw, 280px" widths={[360, 560, 720]} />
      </div>

      <div class="north" id="skandinavien" data-reveal>
        <div class="prose">
          <h3>Was mich an Skandinavien begeistert</h3>
          <p>
            Ich mag die skandinavischen Länder sehr. Da ist zum einen die raue Natur: Fjorde, Felsen, Wasserfälle und
            eine Weite, in der man sich ganz schön klein vorkommt. Auf der Trolltunga in Norwegen zu stehen, weit
            über dem Fjord, gehört zu den Momenten, die ich nicht vergesse.
          </p>
          <p>
            Zum anderen begeistert mich die Offenheit für Fortschritt, die ich mit diesen Ländern verbinde.
            Digitalisierung, Elektromobilität und erneuerbare Energien wie Wind und Sonne interessieren mich. Dort habe
            ich das Gefühl, dass vieles davon ganz selbstverständlich zum Alltag gehört.
          </p>
          <p>
            Genau diese Verbindung spricht mich an: raue Natur und der Mut, neue Wege auszuprobieren. Beides nehme ich
            gern mit nach Hause.
          </p>
        </div>
        <div class="north__photos">
          <Photo id="fjord" sizes="(max-width: 860px) 58vw, 330px" widths={[480, 720, 1000]} />
          <Photo id="norwegen-wasserfall" sizes="(max-width: 860px) 42vw, 240px" widths={[360, 560]} />
        </div>
      </div>
    </div>
  </section>

  <section class="statement" aria-labelledby="gespraech-titel">
    <div class="wrap">
      <p class="dialog__kicker" id="gespraech-titel">Ein gutes Gespräch heißt für mich</p>
      <ol class="dialog">
        <li data-reveal>
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 24h4M18 16v16M24 10v28M30 16v16M36 24h4" /></svg>
          <strong>Zuhören.</strong>
          <span>Verstehen wollen, was den anderen wirklich bewegt.</span>
        </li>
        <li data-reveal>
          <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="15" y="12" width="5" height="24" rx="2.5" /><rect x="28" y="12" width="5" height="24" rx="2.5" /></svg>
          <strong>Ausreden lassen.</strong>
          <span>Auch dann, wenn ich schon eine Idee im Kopf habe.</span>
        </li>
        <li data-reveal>
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 14a5 5 0 0 1 5-5h20a5 5 0 0 1 5 5v13a5 5 0 0 1-5 5H21l-8 7v-7h1a5 5 0 0 1-5-5z" /></svg>
          <strong>Meinung sagen.</strong>
          <span>Ehrlich, direkt und auf Augenhöhe.</span>
        </li>
      </ol>
    </div>
  </section>

  <!-- Wegbereiter und Haltung -->
  <section class="section" id="wegbereiter" aria-labelledby="menschen">
    <div class="wrap">
      <p class="kicker">Wegbereiter und Haltung</p>
      <div class="columns">
        <div class="prose">
          <h2 id="menschen">Menschen auf meinem Weg</h2>
          <p>
            Niemand kommt allein so weit. Ich habe viel von Menschen gelernt, die mir etwas zugetraut und mich zugleich
            hinterfragt haben. Sie haben mir Erfahrung weitergegeben, Perspektiven eröffnet und Raum zur Entwicklung
            gelassen. Dieses Vertrauen prägt, wie ich heute andere begleite.
          </p>
          <p><a href="/gedanken/warum-mentoren-so-wichtig-sind/">Wie mich die vier gefördert haben →</a></p>
          <ul class="mentors">
            {mentors.map((m) => (
              <li>
                <Photo id={m.id} sizes="96px" widths={[96, 192, 250]} />
                <span>{m.name}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="prose">
          <h3>Was mir wichtig ist</h3>
          <p>
            Mir ist wichtig, dass ich mich mit jemandem auf Augenhöhe unterhalten kann und dass das Gespräch nicht
            oberflächlich bleibt.
          </p>
          <ul class="arrows">
            <li>Ein gutes Gespräch heißt für mich: zuhören, ausreden lassen und die eigene Meinung sagen.</li>
            <li>Ich bin ehrlich, sehr direkt und offen.</li>
            <li>Ich schwimme auch mal gegen den Strom und mache mein Ding, auch wenn das nicht immer allen passt.</li>
          </ul>
        </div>
      </div>

      <div class="benno split split--flip" data-reveal>
        <Photo id="benno-eisbaden" sizes="(max-width: 760px) 100vw, 520px" widths={[480, 720]} caption />
        <div class="prose">
          <h3>Eiskalt verbunden</h3>
          <p>
            Benno Löffler inspiriert mich. Er ist „schuld“ daran, dass ich am Ende den Schritt in die Selbstständigkeit
            gewagt habe, und dafür bin ich ihm total dankbar.
          </p>
          <p>
            Mit Benno verbindet mich die Freude daran, Dinge gemeinsam weiterzudenken. Wir diskutieren viel und
            haben beide jede Menge Ideen. Manchmal wird aus einem Gedanken gleich die nächste Frage. Genau diesen
            Austausch mag ich: sich gegenseitig herausfordern, die eigene Sicht hinterfragen und zusammen auf neue
            Ideen kommen.
          </p>
          <p>
            Aus der Zusammenarbeit ist nicht nur eine berufliche Verbindung geworden, sondern eine echte Freundschaft.
            Zusammengeschweißt hat uns unter anderem die Kälte: Im Januar 2025 waren wir beim Lagerfeuer von Vollmer
            &amp; Scheffczyk. Bei Minusgraden ging es für uns gemeinsam in den See zum Eisbaden. „Zusammengefroren“ wäre
            für diesen Moment vielleicht das passendere Wort gewesen. :-)
          </p>
          <p>
            Das Foto von uns kurz vor dem Eisbaden gehört deshalb für mich hierher. Neben den Diskussionen und all den
            Ideen ist eben auch Platz für solche Geschichten. Und für ein bisschen Humor sowieso.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Gemeinsames Buch mit Benno -->
  <section class="book-feature" id="buch" aria-labelledby="buch-titel">
    <div class="wrap">
      <div class="book-feature__visual" data-reveal>
        <a href={book.url} rel="noopener" aria-label={`Website zum Buch ${book.title}`}><Book /></a>
      </div>
      <div class="prose">
        <p class="kicker">Unser neues Buch</p>
        <h2 id="buch-titel">Höchstleistungs-<em>Killer</em> <span>{book.suffix}</span></h2>
        <p class="subline">{book.subtitle}</p>
        <p>
          Benno und ich schreiben gerade gemeinsam ein Buch. Es geht darum, wie Unternehmen ihre Leistungsfähigkeit
          verlieren, ohne es zu wollen – und wie sie sie zurückholen.
        </p>
        <ul class="arrows">
          {book.parts.map((part) => <li>{part}</li>)}
        </ul>
        <p class="book-meta">{book.authors} · <span class="tag">#saugutezusammenarbeit</span> · Erscheint {book.release}</p>
        <div class="actions">
          <a class="btn btn--primary" href={book.url} rel="noopener">Ins Buch reinlesen</a>
          <a class="btn btn--ghost" href="mailto:tietz@v-und-s.de?subject=Vorbestellung%20H%C3%B6chstleistungskiller-Buch">Buch vorbestellen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Buchempfehlungen -->
  <section class="section" id="nachdenken" aria-labelledby="nachdenken-titel">
    <div class="wrap">
      <p class="kicker">Was mich zum Nachdenken bringt</p>
      <h2 id="nachdenken-titel">Drei Bücher, die ich auch noch empfehle</h2>
      <div class="recs">
        {recommendations.map((r) => {
          return (
            <article class="rec" data-reveal>
              <a class="rec-cover" href={r.buy} rel="noopener" aria-label={`${r.title} kaufen`}>
                <Photo id={r.coverId} sizes="220px" widths={[240, 480]} />
              </a>
              <h3>{r.title}</h3>
              <p class="by">{r.author} · {r.meta}</p>
              <p>{r.about}</p>
              <p class="why">{r.why}</p>
              <div class="actions">
                <a class="btn btn--primary" href={r.buy} rel="noopener">{r.buyLabel}</a>
                <a class="btn btn--ghost" href={r.site} rel="noopener">{r.siteLabel}</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Zwei aktuelle Gedanken – ausgeblendet, solange nichts veröffentlicht ist -->
  {latest.length > 0 && (
    <section class="section" id="gedanken" aria-labelledby="gedanken-titel">
      <div class="wrap">
        <p class="kicker">Gedanken</p>
        <h2 id="gedanken-titel">Aktuelle Gedanken</h2>
        <div class="post-list post-list--two">
          {latest.map((post) => <PostCard post={post} />)}
        </div>
        <p class="actions"><a class="btn btn--ghost" href="/gedanken/">Alle Gedanken</a></p>
      </div>
    </section>
  )}

  <!-- Kontakt -->
  <section class="contact" id="kontakt" aria-labelledby="kontakt-titel">
    <div class="wrap">
      <div class="prose">
        <p class="kicker">Kontakt</p>
        <h2 id="kontakt-titel">Lass uns sprechen</h2>
        <p class="lead">
          Du hast ein Thema, eine Idee oder eine Frage? Schreib mir ein paar Zeilen dazu. Dann schauen wir gemeinsam,
          ob und wie ich dich unterstützen kann.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href={mailto('Anfrage Coaching')}>Coaching anfragen</a>
          <a class="btn btn--ghost" href={mailto()}>E-Mail schreiben</a>
        </div>
      </div>
      <address>
        {c.name}<br />
        {c.street}<br />
        {c.city}<br />
        Telefon: <a href={c.phoneHref}>{c.phone}</a><br />
        E-Mail: <a href={mailto()}>{c.email}</a>
      </address>
    </div>
  </section>
</Base>
