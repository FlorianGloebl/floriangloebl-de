---
import Base from '../layouts/Base.astro';
---

<Base title="Seite nicht gefunden" noindex>
  <section class="section">
    <div class="wrap prose">
      <p class="kicker">404</p>
      <h1>Hier geht es nicht weiter.</h1>
      <p class="subline">Diese Seite gibt es nicht (mehr). Manchmal ist der Umweg der bessere Weg.</p>
      <div class="actions">
        <a class="btn btn--primary" href="/">Zur Startseite</a>
        <a class="btn btn--ghost" href="/gedanken/">Zu den Gedanken</a>
      </div>
    </div>
  </section>
</Base>
