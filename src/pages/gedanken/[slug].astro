---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { getPosts } from '../../data/posts';
import { formatDate } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, cover, people = [], sources, draft } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={description} noindex={draft}>
  <article class="article">
    <div class="wrap">
      <header>
        <p class="post-meta">
          {draft && <span class="badge-draft">Entwurf – nur lokale Vorschau</span>}
          {pubDate && <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>}
          {pubDate && ' · '}{category}
        </p>
        <h1>{title}</h1>
        <p class="subline">{description}</p>
        {people.length > 0 && (
          <ul class="mentors article-people">
            {people.map((p) => (
              <li>
                <Photo id={p.photo} sizes="96px" widths={[96, 192, 250]} />
                <span>{p.name}</span>
              </li>
            ))}
          </ul>
        )}
      </header>
      {cover && (
        <div class="cover">
          <Photo id={cover} sizes="(max-width: 1100px) 100vw, 1024px" priority />
        </div>
      )}
      <div class="body">
        <Content />
      </div>
      {updatedDate && <p class="back post-meta">Aktualisiert am {formatDate(updatedDate)}</p>}
      {sources.length > 0 && (
        <div class="sources">
          <h2>Quellen</h2>
          <ul class="arrows">
            {sources.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
          </ul>
        </div>
      )}
      <p class="back"><a href="/gedanken/">← Alle Gedanken</a></p>
    </div>
  </article>
</Base>
